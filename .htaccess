# Configurações privadas nunca são entregues por HTTP.
<FilesMatch "(?i)^(?:\.env(?:\..*)?|config(?:\.local(?:\.example)?)?\.php)$">
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
</FilesMatch>
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^\.git(?:/|$) - [F,L]
</IfModule>
