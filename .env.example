# Censo — configuração exclusiva deste sistema. Copie para .env.
# Ordem: variáveis do servidor > .env > configuração PHP legada > padrões.
# Não versione o .env. Reinicie o serviço PHP se usar variáveis do servidor.
# Aspas simples preservam o conteúdo literal; em aspas duplas use escapes JSON.

CENSO_TIMEZONE="America/Sao_Paulo"
# Nome do cookie desta instalação (altere ao reiniciar uma instalação existente).
CENSO_SESSION_NAME="censo_sess"
# Opcional. Sem esta variável, o endereço é detectado automaticamente.
# CENSO_BASE_URL="https://seu-servidor/horacius-tools/funcoes/Censo"

# Use apenas os ambientes disponíveis; o primeiro é o padrão inicial.
CENSO_DB_AMBIENTES="producao,homologacao"
CENSO_DB_PRODUCAO_ROTULO="Produção"
CENSO_DB_PRODUCAO_HOST=""
CENSO_DB_PRODUCAO_PORT="3306"
CENSO_DB_PRODUCAO_NAME="horacius"
CENSO_DB_PRODUCAO_USER=""
CENSO_DB_PRODUCAO_PASS=""

CENSO_DB_HOMOLOGACAO_ROTULO="Homologação"
CENSO_DB_HOMOLOGACAO_HOST=""
CENSO_DB_HOMOLOGACAO_PORT="3306"
CENSO_DB_HOMOLOGACAO_NAME="horacius"
CENSO_DB_HOMOLOGACAO_USER=""
CENSO_DB_HOMOLOGACAO_PASS=""

# Microsoft Graph / Entra ID. Aplicação com permissão Mail.Send.
CENSO_GRAPH_TENANT_ID=""
CENSO_GRAPH_CLIENT_ID=""

# Cada identificador abaixo corresponde a uma caixa e ao seu segredo.
# Para adicionar caixas, inclua um identificador e os três campos correspondentes.
CENSO_REMETENTES="seginfo"
CENSO_REMETENTE_SEGINFO_EMAIL=""
CENSO_REMETENTE_SEGINFO_NOME="Segurança da Informação"
CENSO_REMETENTE_SEGINFO_SECRET=""

CENSO_LINK_REVISAO="https://horacius.ecossistemaanima.com.br/portal/?menu=access-review"
